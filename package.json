{
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "turbo": "2.9.18",
    "typescript": "^6.0.3",
    "ultracite": "7.8.3",
    "vitest": "^4.1.9"
  },
  "name": "sakti-code",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "mem": "RUN_MEM_BENCH=1 NODE_OPTIONS=--expose-gc vitest run packages/agent/src/__tests__/mem-bench.test.ts --disable-console-intercept",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "hmr": "turbo run hmr",
    "build:canary": "turbo run build:canary",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "dev:server": "bun run --watch apps/server/src/index.ts",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "packageManager": "bun@1.2.15"
}
