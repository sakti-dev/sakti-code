{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"],
    "paths": {
      "@sakti-code/agent": ["./packages/agent/src/index.ts"],
      "@sakti-code/db": ["./packages/db/src/index.ts"],
      "@sakti-code/tools": ["./packages/tools/src/index.ts"]
    },
    "strictNullChecks": true
  },
  "include": ["packages/*/src/**/*.ts"],
  "exclude": ["packages/**/__tests__/**"]
}
