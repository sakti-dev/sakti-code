{
  "name": "app",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n server,web,desktop -c blue,green,magenta \"bun run dev:server\" \"bun run dev:web\" \"bun run dev:desktop\"",
    "dev:server": "cd ../../ && bun dev:server",
    "dev:web": "vite --port 5173",
    "dev:desktop": "SAKTI_DEV=1 electrobun dev",
    "start": "vite build && electrobun dev",
    "typecheck": "tsc --noEmit",
    "build:canary": "vite build && electrobun build --env=canary"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.4.9",
    "@sakti-code/server": "workspace:*",
    "electrobun": "1.18.1",
    "elysia": "^1.4.29"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^9.1.0",
    "solid-js": "^1.9.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-solid": "^2.11.0"
  }
}
