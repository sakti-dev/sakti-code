{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Sakti desktop coding agent (Electron + SolidJS)",
  "homepage": "https://github.com/sakti-dev/sakti-code",
  "license": "MIT",
  "author": "Ardian Eka Candra <ardianoption@gmail.com>",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js",
    "dev": "node scripts/dev.mjs",
    "build:electron": "electron-vite build",
    "package": "vp run -r build && electron-vite build && electron-builder",
    "rebuild": "electron-builder install-app-deps",
    "spike": "electron spike.mjs",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@corvu/resizable": "^0.2.5",
    "@kobalte/core": "^0.13.11",
    "@sakti-code/agent": "workspace:*",
    "@sakti-code/llm": "workspace:*",
    "@sakti-code/logger": "workspace:*",
    "@sakti-code/server": "workspace:*",
    "@solid-primitives/presence": "^0.1.3",
    "@solid-primitives/virtual": "^0.2.3",
    "@tanstack/solid-virtual": "^3.13.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "hono": "^4.12.26",
    "motion-solidjs": "^0.5.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tailwindcss-animate": "^1.0.7",
    "velomark": "workspace:*"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@solidjs/testing-library": "^0.8.10",
    "@swc/core": "^1.15.43",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.0.0",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "vite": "catalog:",
    "vite-plugin-solid": "^2.11.0",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "optionalDependencies": {
    "@ff-labs/fff-bin-linux-x64-gnu": "^0.9.6",
    "node-pty": "^1.1.0"
  },
  "productName": "sakti-code"
}
