{
  "name": "@sakti-code/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/app.ts",
      "types": "./dist/app.d.mts",
      "default": "./dist/app.mjs"
    },
    "./create-server": {
      "development": "./src/create-server.ts",
      "types": "./dist/create-server.d.mts",
      "default": "./dist/create-server.mjs"
    },
    "./dirs": {
      "development": "./src/lib/config-dirs.ts",
      "types": "./dist/dirs.d.mts",
      "default": "./dist/dirs.mjs"
    },
    "./ws": {
      "development": "./src/agent/ws-handler.ts",
      "types": "./dist/ws.d.mts",
      "default": "./dist/ws.mjs"
    }
  },
  "scripts": {
    "build": "vp pack",
    "dev": "NODE_OPTIONS=--conditions=development tsx src/index.ts",
    "start": "NODE_OPTIONS=--conditions=development tsx src/index.ts",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.9.6",
    "@hono/node-server": "^2.0.6",
    "@hono/typebox-validator": "^1.1.0",
    "@sakti-code/agent": "workspace:*",
    "@sakti-code/db": "workspace:*",
    "@sakti-code/llm": "workspace:*",
    "@sakti-code/logger": "workspace:*",
    "@sakti-code/tools": "workspace:*",
    "@vscode/ripgrep": "^1.18.0",
    "effect": "4.0.0-beta.90",
    "hono": "^4.12.26",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "typebox": "^1.2.18",
    "vitest": "catalog:",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "node-gyp": "^13.0.0",
    "tsx": "^4.19.2",
    "vite-plus": "catalog:"
  }
}
