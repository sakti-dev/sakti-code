{
  "name": "@sakti-code/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    },
    "./create-server": {
      "types": "./src/create-server.ts",
      "default": "./src/create-server.ts"
    },
    "./ws": {
      "types": "./src/agent/ws-handler.ts",
      "default": "./src/agent/ws-handler.ts"
    }
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.6",
    "@hono/typebox-validator": "^1.1.0",
    "@sakti-code/agent": "workspace:*",
    "@sakti-code/db": "workspace:*",
    "@sakti-code/llm": "workspace:*",
    "@sakti-code/logger": "workspace:*",
    "@sakti-code/tools": "workspace:*",
    "hono": "^4.12.26",
    "node-pty": "^1.1.0",
    "proper-lockfile": "^4.1.2",
    "vitest": "^4.1.9",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "node-gyp": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
