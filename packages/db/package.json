    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@sakti-code/agent": "workspace:*",
    "@sakti-code/tools": "workspace:*",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-orm": "1.0.0-rc.3"
  },
  "devDependencies": {
    "@types/node": "^24",
    "vitest": "^3"
  }
}
