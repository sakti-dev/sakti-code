{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vitest",
    "ultracite/biome/solid"
  ],
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "style": {
        "noExportedImports": "off",
        "useDefaultSwitchClause": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noUselessUndefined": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noEmptyBlockStatements": "off",
            "noTemplateCurlyInString": "off",
            "useAwait": "off"
          },
          "style": {
            "noNonNullAssertion": "off",
            "useBlockStatements": "off",
            "noParameterProperties": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/agent/src/**", "packages/tools/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off",
            "noExcessiveCognitiveComplexity": "off",
            "noVoid": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noControlCharactersInRegex": "off",
            "noEmptyBlockStatements": "off",
            "noBitwiseOperators": "off",
            "useIterableCallbackReturn": "off",
            "useAwait": "off"
          },
          "performance": {
            "useTopLevelRegex": "off"
          },
          "style": {
            "useGroupedAccessorPairs": "off",
            "useConsistentMemberAccessibility": "off",
            "useConsistentTypeDefinitions": "off",
            "useConsistentArrayType": "off",
            "noNonNullAssertion": "off",
            "useReadonlyClassProperties": "off",
            "noNestedTernary": "off",
            "useAtIndex": "off",
            "useForOf": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/server/src/agent/**",
        "apps/server/src/routes/session-controls.ts",
        "apps/server/src/terminal/**"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off",
            "noExplicitAny": "off",
            "useAwait": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/db/src/session-entry-store.ts",
        "packages/db/src/init.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          },
          "style": {
            "useConsistentArrayType": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/db/migrations/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ]
}
