{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/vitest",
    "ultracite/biome/solid"
  ],
  "javascript": {
    "globals": ["Bun"]
  },
  "linter": {
    "rules": {
      "performance": {
        "noBarrelFile": "off",
        "noNamespaceImport": "off"
      },
      "style": {
        "noExportedImports": "off",
        "useDefaultSwitchClause": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/__tests__/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noEmptyBlockStatements": "off",
            "useAwait": "off"
          },
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/agent/src/**", "packages/tools/src/**"],
      "linter": {
        "rules": {
          "complexity": {
            "noBannedTypes": "off",
            "noExcessiveCognitiveComplexity": "off"
          },
          "suspicious": {
            "noExplicitAny": "off",
            "noControlCharactersInRegex": "off",
            "useIterableCallbackReturn": "off",
            "useAwait": "off"
          },
          "style": {
            "useGroupedAccessorPairs": "off",
            "useConsistentMemberAccessibility": "off",
            "useConsistentTypeDefinitions": "off",
            "useConsistentArrayType": "off",
            "noNonNullAssertion": "off",
            "useReadonlyClassProperties": "off",
            "noNestedTernary": "off",
            "useAtIndex": "off",
            "useForOf": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/db/src/session-entry-store.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "useAwait": "off"
          },
          "style": {
            "useConsistentArrayType": "off"
          }
        }
      }
    }
  ]
}
