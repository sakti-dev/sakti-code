{
	"$schema": "https://turbo.build/schema.json",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"cache": false,
			"persistent": true
		},
		"hmr": {
			"cache": false,
			"persistent": true
		},
		"build:canary": {
			"dependsOn": ["^build:canary"],
			"outputs": ["dist/**", "build/**"]
		}
	}
}
